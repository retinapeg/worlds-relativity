{
  "name": "relativity-drive",
  "version": "0.1.0",
  "private": true,
  "description": "Local special-relativity demonstration",
  "type": "module",
  "scripts": {
    "prepare:reactor": "node scripts/prepare-reactor-sdk.mjs",
    "predev": "npm run prepare:reactor",
    "prebuild": "npm run prepare:reactor",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@reactor-models/happy-oyster": "1.0.0",
    "aliyun-rtc-sdk": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
