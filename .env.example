# Copy to .env.server (ignored), then chmod 600 .env.server.
# These are SERVER values, never VITE_* variables.
REACTOR_API_KEY=replace-with-primary-reactor-key
REACTOR_API_KEY_PREVIOUS=optional-previous-key-only-after-explicit-invalid-primary
DEMO_ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Use the existing protected Modal bridge; set local URL for offline backend work.
REACTOR_BACKEND_URL=https://retinapeg--worlds-relativity-bridge-web.modal.run
# Optional Runware starting-frame generation. Set an allowance only after approval.
RUNWARE_API_KEY=
RUNWARE_GENERATION_ALLOWANCE=0
# Reserved for later media work; unused in this MVP.
FAL_KEY=optional-fal-key
